{
  "name": "@fatihdogmus/opencode-codex-guardian",
  "version": "1.0.0",
  "description": "Codex Guardian permission reviews for OpenCode V2",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatihdogmus/opencode-plugins.git",
    "directory": "packages/codex-guardian"
  },
  "homepage": "https://github.com/fatihdogmus/opencode-plugins/tree/main/packages/codex-guardian#readme",
  "bugs": {
    "url": "https://github.com/fatihdogmus/opencode-plugins/issues"
  },
  "keywords": [
    "opencode",
    "codex",
    "guardian",
    "permissions",
    "plugin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts test/transports/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "verify:live": "node --import tsx scripts/verify-live.ts",
    "verify:code-mode": "node --import tsx scripts/verify-code-mode.ts"
  },
  "dependencies": {
    "@opencode/client": "2.0.24",
    "@opencode/plugin": "2.0.24",
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  }
}
