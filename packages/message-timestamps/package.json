{
  "name": "@fatihdogmus/opencode-message-timestamps",
  "version": "0.1.0",
  "description": "Adds each reply's completion time, in your computer's time zone, to the OpenCode TUI's assistant footer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatihdogmus/opencode-plugins.git",
    "directory": "packages/message-timestamps"
  },
  "homepage": "https://github.com/fatihdogmus/opencode-plugins/tree/main/packages/message-timestamps#readme",
  "bugs": {
    "url": "https://github.com/fatihdogmus/opencode-plugins/issues"
  },
  "keywords": [
    "opencode",
    "tui",
    "timestamps",
    "timezone",
    "plugin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    "./tui": "./src/tui.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.4"
  },
  "devDependencies": {
    "@opencode/theme": "2.3.2",
    "@opentui/core": "0.9.4",
    "@types/node": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
