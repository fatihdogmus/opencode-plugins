{
  "name": "voice-input",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode Desktop GUI plugin: a mic pill above the prompt that records your voice, transcribes it with codex-asr or Hex, and types the text into the prompt.",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@opencode/theme": "^2.2.0",
    "@opentui/core": "^0.7.0",
    "@opentui/solid": "^0.7.0",
    "@types/node": "^22.0.0",
    "electron": "^39.0.0",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.0"
  }
}
