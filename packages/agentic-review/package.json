{
  "name": "@fatihdogmus/opencode-agentic-review",
  "version": "1.0.0",
  "description": "OpenCode V2 plugin that records agent turns for the Agentic Review IntelliJ plugin through its MCP server",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatihdogmus/opencode-plugins.git",
    "directory": "packages/agentic-review"
  },
  "homepage": "https://github.com/fatihdogmus/opencode-plugins/tree/main/packages/agentic-review#readme",
  "bugs": {
    "url": "https://github.com/fatihdogmus/opencode-plugins/issues"
  },
  "keywords": [
    "opencode",
    "agentic-review",
    "intellij",
    "mcp",
    "plugin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opencode/plugin": "2.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  }
}
